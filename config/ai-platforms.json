{
  "platforms": {
    "morbuke": {
      "type": "openai_compatible",
      "apiKey": "${OPENAI_COMPAT_API_KEY}",
      "baseUrl": "https://cn.morbuke.com/v1",
      "options": {
        "disableThinking": true,
        "disableMaxTokens": true
      }
    },
    "qwen": {
      "type": "dashscope",
      "apiKey": "${DASHSCOPE_API_KEY}",
      "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "options": {
        "enableThinking": false
      }
    },
    "bigmodel": {
      "type": "openai_compatible",
      "apiKey": "${BIGMODEL_API_KEY}",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "options": {
        "enableThinking": true,
        "disableMaxTokens": true
      }
    },
    "siliconflow": {
      "type": "siliconflow",
      "apiKey": "${SILICONFLOW_API_KEY}",
      "baseUrl": "https://api.siliconflow.cn/v1"
    },
    "siliconflow-chat": {
      "type": "openai_compatible",
      "apiKey": "${SILICONFLOW_API_KEY}",
      "baseUrl": "https://api.siliconflow.cn/v1",
      "options": {
        "disableThinking": true,
        "disableMaxTokens": true
      }
    },
    "tokenrhythm": {
      "type": "openai_compatible",
      "apiKey": "${TOKENRHYTHM_API_KEY}",
      "baseUrl": "https://tokenrhythm.studio/v1",
      "options": {
        "enableThinking": true,
        "contextWindowTokens": 1000000,
        "maxOutputTokens": 131072
      }
    },
    "opencode-go": {
      "type": "opencode_go",
      "apiKey": "${OPENCODE_GO_API_KEY}",
      "baseUrl": "https://opencode.ai/zen/go/v1",
      "options": {
        "enableThinking": true
      }
    },
    "mock": {
      "type": "mock"
    }
  },
  "capabilities": {
    "agent_turn": {
      "platform": "tokenrhythm",
      "model": "qwen3.8-flash"
    },
    "text_generation": {
      "platform": "siliconflow-chat",
      "model": "THUDM/GLM-4-9B-0414"
    },
    "companion_fallback": {
      "platform": "siliconflow-chat",
      "model": "THUDM/GLM-4-9B-0414"
    },
    "vision": {
      "platform": "bigmodel",
      "model": "GLM-4.1V-Thinking-Flash"
    },
    "embedding": {
      "platform": "siliconflow",
      "model": "BAAI/bge-m3"
    }
  },
  "tts": {
    "engine": "qwen",
    "qwen": {
      "model": "qwen-audio-3.0-tts-flash",
      "voice": "longanlingxi",
      "format": "mp3",
      "sampleRate": 22050,
      "workspaceId": "llm-55ujpy2wafojbdp8",
      "instruction": "可爱的年轻女性声音，25 岁左右，声音甜美温柔、略带活泼，语速自然适中，适合轻松陪伴式对话"
    },
    "edge": {
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "+0%"
    }
  }
}