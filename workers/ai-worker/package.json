{
  "name": "@ailearn/ai-worker",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find src -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@ailearn/shared": "file:../../packages/shared",
    "@ailearn/db": "file:../../packages/db",
    "postgres": "^3.4.5",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.23.8",
    "pino": "^9.5.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "esbuild": "^0.28.1"
  }
}
