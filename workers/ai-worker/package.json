{
  "name": "@ailearn/ai-worker",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=cjs --external:dashscope-sdk-official --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/handlers/parse-source.test.ts src/lib/worker-reliability.test.ts src/lib/providers/dashscope.test.ts src/lib/providers/openai-compatible.test.ts"
  },
  "dependencies": {
    "@ailearn/shared": "file:../../packages/shared",
    "@ailearn/db": "file:../../packages/db",
    "postgres": "^3.4.5",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.23.8",
    "uuid": "^11.0.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "dashscope-sdk-official": "^1.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "esbuild": "^0.24.0"
  }
}
