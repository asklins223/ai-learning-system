# Alpha 环境 .env 模板（OPS-01）
#
# 复制为 .env 并填入真实值后使用：
#   cp .env.alpha.example .env
#   make alpha-up

# ─── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=ailearn
POSTGRES_PASSWORD=<set-a-strong-password>
POSTGRES_DB=ailearn

# ─── Least-privilege roles ───────────────────────────────────────────
MIGRATOR_PASSWORD=<set-a-strong-password>
API_PASSWORD=<set-a-strong-password>
WORKER_PASSWORD=<set-a-strong-password>

# Use URL-encoded copies of the matching role passwords above.
DATABASE_URL_MIGRATOR=postgres://ailearn_migrator:<url-encoded-migrator-password>@postgres:5432/ailearn
DATABASE_URL_API=postgres://ailearn_api:<url-encoded-api-password>@postgres:5432/ailearn
DATABASE_URL_WORKER=postgres://ailearn_worker:<url-encoded-worker-password>@postgres:5432/ailearn

# ─── MinIO / S3 ─────────────────────────────────────────────────────
MINIO_ROOT_USER=ailearn
MINIO_ROOT_PASSWORD=<set-a-strong-password>
S3_BUCKET=ailearn-workspaces
BACKUP_BUCKET=ailearn-backups

# ─── API ─────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
AI_PROVIDER_CARD=mock
AI_CREDENTIAL_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# For real AI provider (uncomment and set key):
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_MODEL=qwen-plus

# ─── Web ─────────────────────────────────────────────────────────────
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000

# ─── Monitoring (Alpha overlay) ─────────────────────────────────────
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
ALERTMANAGER_BIND_ADDRESS=127.0.0.1
ALERTMANAGER_PORT=9093

# ─── Backup (Alpha overlay) ──────────────────────────────────────────
SOURCE_RELEASE=0.5.0-alpha
# SOURCE_COMMIT is set automatically by alpha-env-setup.sh
SOURCE_MIGRATION=0039
