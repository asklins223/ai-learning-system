{
  "name": "@ailearn/web",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find lib -name '*.test.ts' | sort)",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=list --reporter=html"
  },
  "dependencies": {
    "@ailearn/shared": "file:../../packages/shared",
    "@milkdown/kit": "^7.21.3",
    "@milkdown/react": "^7.21.3",
    "katex": "^0.18.1",
    "next": "^15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
