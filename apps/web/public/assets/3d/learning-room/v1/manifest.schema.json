{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "assetBase",
    "coordinateSystem",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "revision": {
      "type": "integer"
    },
    "reviewOnly": {
      "type": "boolean"
    },
    "assetBase": {
      "type": "string"
    },
    "coordinateSystem": {
      "type": "object"
    },
    "entries": {
      "type": "array"
    }
  }
}
