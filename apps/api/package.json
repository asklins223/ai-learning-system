{
  "name": "@ailearn/api",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find src -name '*.test.ts' | sort)",
    "test:learning-runs:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/learning-runs-postgres.integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test:companion:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-migration-postgres.integration.ts src/integration-tests/companion-conversation-postgres.integration.ts",
    "test:companion-home-profile:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-home-profile-rls-postgres.integration.ts",
    "test:companion-runtime-fence:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-runtime-fence-postgres.integration.ts",
    "test:companion-actions:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-action-migration-postgres.integration.ts src/integration-tests/companion-action-rls-postgres.integration.ts src/integration-tests/companion-action-bridge-postgres.integration.ts",
    "test:companion-integration:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-answer-mode-preference-postgres.integration.ts src/integration-tests/companion-account-epoch-postgres.integration.ts src/integration-tests/companion-memory-star-map-postgres.integration.ts src/integration-tests/companion-audit-export-delete-postgres.integration.ts src/integration-tests/companion-pet-profile-postgres.integration.ts src/integration-tests/companion-memory-routes-http-postgres.integration.ts src/integration-tests/companion-migration-postgres.integration.ts src/integration-tests/companion-conversation-postgres.integration.ts src/integration-tests/companion-run-nodes-window-postgres.integration.ts src/integration-tests/companion-home-profile-rls-postgres.integration.ts src/integration-tests/companion-runtime-fence-postgres.integration.ts src/integration-tests/companion-action-migration-postgres.integration.ts src/integration-tests/companion-action-rls-postgres.integration.ts src/integration-tests/companion-action-bridge-postgres.integration.ts src/integration-tests/companion-bridge-postgres.integration.ts src/integration-tests/companion-delete-e2e-postgres.integration.ts src/integration-tests/companion-journey-postgres.integration.ts src/integration-tests/companion-proposal-expiry-sweep-postgres.integration.ts src/integration-tests/companion-sandbox-postgres.integration.ts src/integration-tests/assistant-memory-postgres.integration.ts src/integration-tests/assistant-deliveries-postgres.integration.ts src/integration-tests/assistant-deliveries-kind-constraint-postgres.integration.ts src/integration-tests/tool-gateway-postgres.integration.ts"
  },
  "dependencies": {
    "@ailearn/shared": "file:../../packages/shared",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/websocket": "^11.3.0",
    "@hocuspocus/server": "^4.7.0",
    "@smithy/node-http-handler": "^4.9.7",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "lib0": "^0.2.117",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.0",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "pg": "^8.13.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
