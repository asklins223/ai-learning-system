{
  "name": "ailearn-desktop-client",
  "version": "0.1.0",
  "description": "AI Learn immersive desktop study room",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -w --remoteDebuggingPort 9222",
    "build": "npm run validate:room-layers && electron-vite build && npm run validate:room-layers:output",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run --passWithNoTests",
    "validate:room-layers": "node scripts/validate-room-layers.mjs",
    "validate:room-layers:output": "node scripts/validate-room-layers.mjs --manifest out/renderer/assets/learning-room/v1/manifest.json --runtime-root out/renderer/assets/learning-room/v1 --source-manifest src/renderer/public/assets/learning-room/v1/manifest.json --source-root src/renderer/public/assets/learning-room/v1",
    "generate:room-layer-pack": "node scripts/generate-room-layer-pack.mjs --spec scripts/fixtures/room-layer-pack.input.json --out ../../.impeccable/review/room-layer-pack-candidate-v1 --force",
    "generate:room-layer-production-pack": "node scripts/generate-room-layer-pack.mjs --spec scripts/fixtures/room-layer-production-candidate.input.json --out ../../.impeccable/review/room-layer-pack-production-candidate-v1 --force",
    "generate:home-scene-assets": "node scripts/extract-room-scene-assets.mjs --spec apps/desktop-client/scripts/fixtures/lighthouse-home-scene-assets.input.json",
    "sync:home-scene-manifest": "node scripts/sync-room-scene-manifest.mjs --spec apps/desktop-client/scripts/fixtures/lighthouse-home-scene-assets.input.json",
    "capture": "node scripts/capture-scene.mjs",
    "capture:home-v2": "VITE_HOME_SCENE_VARIANT=v2 npm run build && node scripts/capture-home-v2-lighthouse.mjs",
    "capture:review-layout": "npm run build && node scripts/capture-review-layout.mjs",
    "capture:evidence": "npm run build && node scripts/capture-evidence.mjs",
    "evidence:manifest": "node --experimental-strip-types scripts/evidence-manifest.ts --input scripts/fixtures/evidence-manifest.input.json --output .impeccable/evidence/manifest.json --root ../..",
    "package:smoke": "node scripts/smoke-packaged.mjs",
    "package:evidence": "npm run package:smoke && node scripts/package-evidence.mjs",
    "preview": "electron-vite preview",
    "dist": "npm run typecheck && npm run test && npm run build && electron-builder"
  },
  "dependencies": {
    "@ailearn/shared": "file:../../packages/shared",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hocuspocus/provider": "^4.7.0",
    "@milkdown/kit": "^7.22.1",
    "@milkdown/react": "^7.22.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.33.0",
    "pixi.js": "^8.20.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.3",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.32",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^16.4.7",
    "electron": "43.4.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
