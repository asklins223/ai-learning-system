  },
  "sequence": [
    "dom_actions",
    "room_light",
    "lamp_on",
    "companion_or_fallback",
    "wait_for_user",
    "camera_room_to_desk",
    "notebook_open",
    "editable_note"
  ],
  "preserveFields": [
    "url",
    "domainObject",
    "draft",
    "selectedObject",
    "focus",
    "aiTask",
    "learningRunId",
    "completedSteps"
  ]
}
