-// ─── P3-7: 升级矩阵切换前置验证 ─────────────────────────────────────────
-
-export interface UpgradeMatrixPrerequisites {
-  /** Fast ExtractArtifact 可复用(验证过且未受影响) */
-  reusableArtifacts: boolean;
-  /** Gap Detection 能识别 Fast 遗留(覆盖检查) */
