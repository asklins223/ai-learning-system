-  question: z.string().min(1).max(500).optional(),
-  /** 用户答案 */
-  userAnswer: z.string().min(1).max(10_000),
-}).refine(
-  (data) => data.questionId || (data.questionType && data.question),
-  {
-    message: "Either questionId or (questionType + question) must be provided",
-  },
-);
