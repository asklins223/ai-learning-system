-      success: false,
-      result: null,
-      error: "无法创建 Critic unit",
-    };
-  }
-
-  // P1-5：request_grounding_review 已转为系统自动推进（P1-1/P1-3 在
-  // submit_deck_draft 成功 / 子 Agent 完成时自动创建 Critic）。
-  // 工具保留执行（幂等，命中已创建 unit 不重复），但返回
