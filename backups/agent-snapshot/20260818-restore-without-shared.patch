-/** 未接管设备是否可提交：恒为 false（提交为 0，§5.4.7 bullet 4 验收） */
-export function isCommitAllowedForDevice(
-  state: Readonly<MultiDeviceSessionState>,
-  deviceId: string,
-): boolean {
-  return state.ownerDeviceId === deviceId;
-}
