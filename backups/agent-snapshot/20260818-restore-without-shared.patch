-        .select({
-          id: reviewSchedules.id,
-          keyPointId: reviewSchedules.keyPointId,
-          nextReviewAt: reviewSchedules.nextReviewAt,
-          generation: reviewSchedules.generation,
-          policyVersion: reviewSchedules.policyVersion,
