-    await port.setCommitKey(scope, episode.episodeId, commitKey);
-    return {
-      ok: false,
-      idempotent: false,
-      disposition: derived.disposition,
-      scheduleSideEffect: "none",
-      attribution: cas.attribution,
-      casFailures: cas.failures,
-      commitKey,
