-    }
-
-    // 3) Candidate 数量 0 或异常爆炸(§3.2 次条)
-    if (outcome.hasDecision && outcome.decisionKind === "candidate" && outcome.candidateCount === 0) {
-      gaps.push({
-        code: "candidate_zero",
-        severity: "replannable",
-        bundleId: b,
-        message: `bundle ${b} 决策为 candidate 但数量为 0`,
