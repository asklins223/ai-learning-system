-/** 结构交互 Scene（01-2 §6.4：排序/连线/修复/多步情境/反例）。 */
-function isStructuralInteractive(scene: LearningScene): boolean {
-  return (
-    scene.sceneType === "ordering" ||
-    scene.sceneType === "relation_canvas" ||
-    scene.sceneType === "repair" ||
