-      const oldest = this.toolSchemaCache.keys().next().value;
-      if (oldest !== undefined) this.toolSchemaCache.delete(oldest);
-    }
-    this.toolSchemaCache.set(role, {
-      schemas,
-      serializedLength: JSON.stringify(schemas).length,
