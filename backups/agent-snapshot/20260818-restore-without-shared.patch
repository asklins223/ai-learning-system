+  sourceSessionId: string | null;
+  userStated: boolean;
+  userConfirmed: boolean;
+  importance: number;
+  confidence: number;
+  scope: MemoryScopeV2;
+  conflictGroup: string | null;
+  dismissedAt: string | null;
+  createdAt: string;
+  updatedAt: string;
+  linkedEntities: Array<{
+    entityType: "card" | "key_point" | "note" | "source" | "learning_run";
+    entityId: string;
+    entityTitle: string | null;
+    orphaned: boolean;
+  }>;
+}
+
+export async function exportMemories(
+  executor: ApiTransaction,
+  scope: MemoryScope,
+): Promise<MemoryExportRow[]> {
+  const rows = await executor.execute<Record<string, unknown>>(sql`
+    SELECT m.id, m.kind, m.content, m.source_event_id, m.source_session_id,
+           m.user_stated, m.user_confirmed, m.candidate, m.importance, m.confidence,
+           m.scope, m.pinned, m.archived_at, m.dismissed_at, m.conflict_group,
+           m.source_type, m.created_at, m.updated_at,
+           COALESCE(
+             jsonb_agg(
+               jsonb_build_object(
+                 'entityType', l.entity_type,
+                 'entityId', l.entity_id,
+                 'orphaned', l.orphaned
+               )
+             ) FILTER (WHERE l.id IS NOT NULL),
+             '[]'::jsonb
+           ) AS links
+    FROM assistant_memory_items m
+    LEFT JOIN memory_links l
+      ON l.memory_id = m.id
+     AND l.workspace_id = m.workspace_id
+     AND l.user_id = m.user_id
+    WHERE m.workspace_id = ${scope.workspaceId}
+      AND m.user_id = ${scope.userId}
+      AND m.deleted_at IS NULL
+    GROUP BY m.id
+    ORDER BY m.pinned DESC, m.importance DESC, m.updated_at DESC
+  `);
+
+  // 尽力解析实体标题（card→learning_cards.schema_json.title；key_point→claim；
+  // note/source→title；learning_run 无标题）。任一层失败都不阻断导出，标题回落 null。
+  const links = (Array.isArray(rows) ? rows : []).flatMap((row) =>
+    Array.isArray(row.links) ? (row.links as Array<{ entityType: string; entityId: string; orphaned: boolean }>) : [],
+  );
+  const titles = await resolveEntityTitles(executor, scope, links);
+
+  return (Array.isArray(rows) ? rows : []).map((row) => {
+    const archivedAt = row.archived_at ? new Date(String(row.archived_at)) : null;
+    const state: MemoryExportRow["state"] = row.candidate
+      ? "candidate"
+      : archivedAt !== null
+        ? "archived"
+        : row.pinned
+          ? "pinned"
+          : "active";
+    const rowLinks = Array.isArray(row.links)
+      ? (row.links as Array<{ entityType: string; entityId: string; orphaned: boolean }>)
+      : [];
+    return {
+      memoryItemId: String(row.id),
+      kind: String(row.kind) as MemoryKindV2,
+      content: String(row.content),
+      state,
+      sourceType: String(row.source_type ?? "model_inferred") as MemorySourceTypeV2,
+      sourceEventId: row.source_event_id ? String(row.source_event_id) : null,
+      sourceSessionId: row.source_session_id ? String(row.source_session_id) : null,
+      userStated: Boolean(row.user_stated),
+      userConfirmed: Boolean(row.user_confirmed),
+      importance: Number(row.importance ?? 0.5),
+      confidence: Number(row.confidence ?? 0.5),
+      scope: String(row.scope ?? "workspace") as MemoryScopeV2,
+      conflictGroup: row.conflict_group ? String(row.conflict_group) : null,
+      dismissedAt: row.dismissed_at ? new Date(String(row.dismissed_at)).toISOString() : null,
+      createdAt: new Date(String(row.created_at)).toISOString(),
+      updatedAt: new Date(String(row.updated_at)).toISOString(),
+      linkedEntities: rowLinks.map((link) => ({
+        entityType: link.entityType as MemoryExportRow["linkedEntities"][number]["entityType"],
+        entityId: link.entityId,
+        entityTitle: titles.get(`${link.entityType}:${link.entityId}`) ?? null,
+        orphaned: link.orphaned,
+      })),
+    };
+  });
+}
+
+/** 尽力解析 memory_links 实体标题：UNION 各实体表，按 (entityType, entityId) 返回。 */
+async function resolveEntityTitles(
+  executor: ApiTransaction,
+  scope: MemoryScope,
+  links: Array<{ entityType: string; entityId: string }>,
+): Promise<Map<string, string>> {
+  const titles = new Map<string, string>();
+  if (links.length === 0) return titles;
+  const ids = links.map((link) => link.entityId);
+  // R29/R32：drizzle+postgres-js 数组参数序列化不可靠，使用显式 uuid[] 字面量。
+  const idsLiteral = `{${ids.join(",")}}`;
+  try {
+    const rows = await executor.execute<{ entityType: string; entityId: string; title: string | null }>(sql`
+      SELECT 'card' AS "entityType", id AS "entityId", (schema_json->>'title') AS title
+      FROM learning_cards
+      WHERE workspace_id = ${scope.workspaceId} AND id = ANY(${idsLiteral}::uuid[])
+      UNION ALL
+      SELECT 'key_point', id, claim
+      FROM learning_objectives_v2
+      WHERE workspace_id = ${scope.workspaceId} AND id = ANY(${idsLiteral}::uuid[])
+      UNION ALL
+      SELECT 'note', id, title
+      FROM notes
+      WHERE workspace_id = ${scope.workspaceId} AND id = ANY(${idsLiteral}::uuid[])
+      UNION ALL
+      SELECT 'source', id, title
+      FROM sources
+      WHERE workspace_id = ${scope.workspaceId} AND id = ANY(${idsLiteral}::uuid[])
+    `);
+    for (const row of Array.isArray(rows) ? rows : []) {
+      if (row.entityType && row.entityId && row.title) {
+        titles.set(`${row.entityType}:${row.entityId}`, row.title);
+      }
+    }
+  } catch (error) {
+    // 标题解析失败不阻断导出（learning_run 本身无标题，card v2 无标题列）。
+    console.warn("companion memory export entity title resolution failed", error);
+  }
+  return titles;
+}
