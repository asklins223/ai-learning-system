-export interface TakeoverAttemptResult {
-  granted: boolean;
-  role: SessionDeviceRole;
-  /** 未接管设备提交为 0（owner 才为 true） */
-  commitAllowed: boolean;
-  /** 只读提示（未接管时提供；不含 target 名称） */
-  readonlyNotice: string | null;
-  takeoverEpoch: number;
-}
