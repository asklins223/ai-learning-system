-
-export interface IncrementalReuseInfo {
-  hasPrevious: boolean;
-  prevVersionNo: number | null;
-  changedSpanCount: number;
-  unchangedSpanCount: number;
-  /** 可复用比例(unchanged / total,0-1);全量场景为 0 */
