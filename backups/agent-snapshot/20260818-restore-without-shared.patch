-    // 4) Specialist 协议错误(§3.2:协议错误 / 引用未分配 Evidence / 类型不匹配)
-    for (const err of outcome.protocolErrors) {
-      gaps.push({
-        code: "specialist_protocol_error",
-        severity: "escalate",
