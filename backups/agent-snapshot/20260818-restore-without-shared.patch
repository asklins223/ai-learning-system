-  // 与 learning-agent/runtime.ts 的 parseStructuredAction 实现保持一致：
-  // JSON.parse 成功但结果为 null/数字/字符串/数组时，直接访问属性同样会抛
-  // TypeError，必须统一按解析失败 fail-soft。
-  let parsed: unknown;
-  try {
-    parsed = JSON.parse(rawOutput);
