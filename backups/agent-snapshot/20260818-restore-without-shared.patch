-  return {
-    systemPromptTokens,
-    rolePolicyTokens,
-    toolSchemaTokens,
-    contextSummaryTokens,
-    evidenceTokens,
-    reservedOutputTokens,
-    totalTokens,
-    contextWindowTokens: config.contextWindowTokens,
-    safetyMarginTokens: config.safetyMarginTokens,
-    availableTokens,
-    exceedsContext,
-    packingStrategy,
-  };
-}
