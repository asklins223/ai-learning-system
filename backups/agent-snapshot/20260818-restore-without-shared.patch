-    if (ev.agentRole !== "generation_supervisor" || ev.eventType !== "tool_request" || !ev.toolName || ev.turnNo == null) {
-      continue;
-    }
-    if (ev.turnNo < windowStart || ev.turnNo > currentTurnNo) {
