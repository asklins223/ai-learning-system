-          .update(schema.jobs)
-          .set({
-            status: JobStatus.PENDING,
-            attempts: 0,
-            lastError: null,
-            scheduledAt: now,
-            startedAt: null,
-            finishedAt: null,
-            leaseToken: null,
-            repairState: "none",
-            repairAttemptCount: 0,
-          })
-          .where(eq(schema.jobs.id, existingJob.id));
