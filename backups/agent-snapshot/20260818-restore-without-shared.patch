-    }
-
-    // 2) Required Bundle 无明确决策(§3.2 首条)
-    if (!outcome.hasDecision) {
-      gaps.push({
-        code: "bundle_no_decision",
-        severity: "replannable",
-        bundleId: b,
-        message: `Required bundle ${b} 无明确决策`,
