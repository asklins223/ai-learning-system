- */
-function parseExtractorResult(
-  result: AgentTurnResult,
-  config: ExtractorConfig,
-  assignedBundles: Array<{
-    bundleId: string;
-    sectionPath: string[];
-    evidenceUnits: Array<{
-      refId: string;
-      kind: string;
-      text: string;
-      contextOnly: boolean;
