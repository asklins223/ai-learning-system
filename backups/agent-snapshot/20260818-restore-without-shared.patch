-
-/** 空的 coverage snapshot（预检失败时返回） */
-function emptyCoverageSnapshot(): CoverageLedgerSnapshot {
-  return {
-    bundles: [],
-    totalBundles: 0,
-    requiredBundles: 0,
-    assignedBundles: 0,
-    decidedBundles: 0,
-    totalCandidates: 0,
-    canonicalCandidates: 0,
-    eligibleCandidates: 0,
-    report: {
-      sourcePhysicalCoverage: 0,
-      bundleAssignmentCoverage: 0,
-      explicitDecisionCoverage: 0,
