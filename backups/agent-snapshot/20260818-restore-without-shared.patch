-        summary: c.claim,
-        candidateIds: [c.candidateId],
-        primarySupportCandidateId: c.candidateId,
-        ordinal: index,
-        primarySection: c.sectionKey || undefined,
-        groupKey: c.groupKey ?? undefined,
-        learningObjective: `理解：${c.claim.slice(0, 40)}`,
