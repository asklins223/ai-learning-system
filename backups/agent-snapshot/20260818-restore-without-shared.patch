-
-export type RoundContextResult =
-  | { ok: true; context: RoundContext }
-  | { ok: false; reason: "destination_missing" | "custom_minutes_required" | "custom_minutes_invalid" };
-
-export interface RoundContextInput {
-  /** 唯一必填 */
