-  LOGIN_EXPIRY: "login_expiry",
-  COMPANION_TOTAL_FAILURE: "companion_total_failure",
-} as const;
-export type RcFaultId = (typeof RcFaultId)[keyof typeof RcFaultId];
-
-// ─── 标准化可观察事实（注入端口返回）────────────────────────────────────
-
-/**
- * 一次故障注入演练的可观察事实（纯数据）。字段默认全部为 false（「什么都没
- * 发生」）；集成层/测试按故障契约置 true。
