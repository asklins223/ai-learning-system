-  if (!validatePreferenceValue(key, value)) return { ok: false, reason: "invalid_value" };
-  return {
-    ok: true,
-    state: {
-      explicit: { ...state.explicit, [key]: value },
-      suggested: state.suggested,
-    },
-  };
