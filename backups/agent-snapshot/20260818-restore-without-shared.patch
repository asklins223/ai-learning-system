-  downgradePrecision: number | null;
-  /** downgrade 判定侧 recall（补充视角，非冻结主指标）。 */
-  downgradeRecall: number | null;
-  /** 相对该层全部样本的四种分层报告率（分母 sampleCount）。 */
-  rates: {
