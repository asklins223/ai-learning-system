-      await transaction.execute(sql`
-        UPDATE learning_session_processing_outbox
-        SET available_at = ${availableAtIso}, leased_at = NULL, lease_owner = NULL,
-            lease_expires_at = NULL, last_error = ${error.slice(0, 1000)},
