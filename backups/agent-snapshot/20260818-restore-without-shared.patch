-  /** system=not_assessable（gold 可判定时）。 */
-  notAssessable: number;
-  /** gold=upgrade 且 system 明确判非 upgrade（no_change/downgrade）。 */
-  missedUpgrade: number;
-  /** gold=downgrade 且 system 明确判非 downgrade。 */
-  missedDowngrade: number;
-  /** 人工双标不一致或无 Gold 共识。 */
-  disagreement: number;
