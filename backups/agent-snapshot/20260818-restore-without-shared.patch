-  const finishReason = typeof record.finishReason === "string"
-    ? record.finishReason
-    : toolCalls.length > 0
-      ? "tool_calls"
-      : "stop";
-
-  return {
-    content,
-    toolCalls,
-    finishReason,
-    usage: null,
-    providerRequestId: null,
-  };
-}
