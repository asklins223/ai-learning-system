-  bundles: PlannedBundle[];
-  /** primary evidence 到 bundle 的映射 */
-  primaryOwnership: Map<string, string>;
-  /** 未分配的 evidence（理论上不应该有，因为所有 required 都是 primary） */
-  unassigned: string[];
-  /** 总 token 估算 */
