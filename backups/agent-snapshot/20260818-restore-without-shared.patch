-  private summarizeSection(section: ContextSection, level: CompressionLevel): ContextSection {
-    if (level === 1) {
-      // Level 1: 摘要化 — 尝试解析 JSON 并只保留关键字段
-      try {
-        const parsed = JSON.parse(section.content) as Record<string, unknown>;
