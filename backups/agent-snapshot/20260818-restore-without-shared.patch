-    }
-
-    const content = prefix + activeSections.map((s) => s.content).join("\n\n");
-    const finalTokens = estimateTokens(content);
-
-    // 可观测性：压缩触发时记录结构化日志
-    if (appliedCompression > 0 || compressionSummary.still_exceeds) {
