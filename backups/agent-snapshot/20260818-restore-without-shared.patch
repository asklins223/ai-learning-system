-    }
-    if (outcome.candidateCount > explosionThreshold) {
-      gaps.push({
-        code: "candidate_explosion",
-        severity: "escalate",
-        bundleId: b,
-        message: `bundle ${b} candidate 数量 ${outcome.candidateCount} 超过阈值 ${explosionThreshold}`,
