+/* 22 方案 §15.2：昨日桌宠日记预览卡片（展示部分内容 + 渐隐截断 + 跳转完整版） */
+
+.today-daily-preview {
+  position: relative;
+  margin: 0 0 20px;
+  padding: 18px 20px 14px;
+  border: 1px solid var(--color-divider);
+  border-radius: 14px;
+  background: color-mix(in srgb, var(--color-paper-muted) 60%, transparent);
+  overflow: hidden;
+}
+
+.today-daily-preview-header {
+  display: flex;
+  align-items: baseline;
+  gap: 10px;
+  margin-bottom: 10px;
+}
+
+.today-daily-preview-eyebrow {
+  font-size: 12px;
+  font-weight: 600;
+  color: var(--color-text-muted);
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+
+.today-daily-preview-title {
+  font-size: 16px;
+  font-weight: 600;
+  margin: 0;
+  color: var(--color-text);
+}
+
+.today-daily-preview-date {
+  font-size: 13px;
+  color: var(--color-text-muted);
+  margin-left: auto;
+}
+
+.today-daily-preview-body {
+  /* 关键：限制高度营造"看不全"的感觉 */
+  max-height: 96px;
+  overflow: hidden;
+  position: relative;
+}
+
+.today-daily-preview-summary {
+  font-size: 14px;
+  line-height: 1.6;
+  color: var(--color-text);
+  margin: 0 0 8px;
+  /* 文本截断：超出 2 行显示省略号 */
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+
+.today-daily-preview-facts {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px 14px;
+}
+
+.today-daily-preview-facts span {
+  font-size: 12px;
+  color: var(--color-text-muted);
+  white-space: nowrap;
+}
+
+.today-daily-preview-empty {
+  font-size: 14px;
+  color: var(--color-text-muted);
+  margin: 0;
+  line-height: 1.6;
+}
+
+/* 底部渐隐遮罩——从 body 底部淡入到卡片背景色 */
+.today-daily-preview-body::after {
+  content: "";
+  position: absolute;
+  bottom: 0;
+  left: 0;
+  right: 0;
+  height: 28px;
+  background: linear-gradient(
+    to bottom,
+    transparent,
+    color-mix(in srgb, var(--color-paper-muted) 60%, transparent)
+  );
+  pointer-events: none;
+}
+
+.today-daily-preview-link {
+  display: inline-flex;
+  align-items: center;
+  margin-top: 10px;
+  font-size: 14px;
+  font-weight: 500;
+  color: var(--color-accent, #4f46e5);
+  text-decoration: none;
+  transition: opacity 0.15s ease;
+}
+
+.today-daily-preview-link:hover {
+  opacity: 0.75;
+}
+
+.today-daily-preview-link:focus-visible {
+  outline: 2px solid var(--color-accent, #4f46e5);
+  outline-offset: 2px;
+  border-radius: 4px;
+}
+
+@container today-page (max-width: 600px) {
+  .today-daily-preview-date {
+    margin-left: 0;
+  }
+}
