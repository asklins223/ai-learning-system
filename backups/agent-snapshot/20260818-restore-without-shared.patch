-    keyPointId: string;
-    decisionRef: string;
-    policyEpoch: number;
-    idempotencyKey: string;
-  }): Promise<{ created: boolean; scheduleId: string | null }>;
-  /** consume_pending：恰好一个 successor（精确 generation 校验 + 唯一消费） */
-  consumePending(options: {
-    workspaceId: string;
-    userId: string;
-    keyPointId: string;
-    inputScheduleId: string;
-    inputScheduleGeneration: number;
-    decisionRef: string;
-    policyEpoch: number;
