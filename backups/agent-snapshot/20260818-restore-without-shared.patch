-/**
- * 升级矩阵启用前置四项验证(§5.3 P3-7 验收):
- * 全部通过才允许 Fast→Planned/Planned→Full 切换。
- */
-export function verifyUpgradeMatrixPrerequisites(p: UpgradeMatrixPrerequisites): PrerequisiteViolation[] {
