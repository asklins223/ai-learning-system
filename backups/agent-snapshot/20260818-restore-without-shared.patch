-  }
-
-  /**
-   * 预留一个并行任务。
-   */
-  reserveParallelTask(role: AgentRole): void {
-    this.ensureRoleUsage(role);
-    const roleBudget = this.budget.roles[role] ?? DEFAULT_ROLE_BUDGETS[role];
-    const roleUsage = this.usage.roles[role]!;
