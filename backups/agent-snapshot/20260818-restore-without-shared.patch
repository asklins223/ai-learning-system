-
-/** 空的 bundle plan（预检失败时返回） */
-function emptyBundlePlan(): BundlePlanResult {
-  return {
-    bundles: [],
-    primaryOwnership: new Map(),
-    unassigned: [],
-    totalTokenEstimate: 0,
-    plannerVersion: "none",
-  };
