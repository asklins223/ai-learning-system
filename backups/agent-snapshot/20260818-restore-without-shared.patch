-
-  return rows.map((r) => ({
-    id: r.id,
-    localId: r.localId,
-    claim: r.claim,
-    topic: r.topic,
-    sectionKey: r.sectionKey,
-    cognitiveType: r.cognitiveType,
-    importance: r.importance,
-    difficulty: r.difficulty,
