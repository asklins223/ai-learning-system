-function operationalKindFor(auditKind: OperationalAuditKind): OperationalKind {
-  switch (auditKind) {
-    case "stale":
-    case "cancelled":
-    case "killed":
-    case "incomplete_silent_bundle":
-      return "terminal";
-    case "provider_failure":
-    case "not_assessable":
-    case "missing_required_artifact":
-      return "retryable";
-    case "contract_invariant_violation":
-      return "terminal";
