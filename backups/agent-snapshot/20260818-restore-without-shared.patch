-  "budget_exhausted",
-  "budget_exhausted_during_pagination",
-  // 快照漂移
-  "provider_fingerprint_mismatch",
-  // 配置/产品阻止
-  "mock_provider_blocked_in_production",
-  "prepare_failed",
-  // 确定性门禁：VERIFY
-  "no_draft_for_verify",
-  "no_quality_report",
-  "verify_failed",
-  "coverage_insufficient",
-  "critic_check_failed",
-  "quality_report_missing",
-  "candidate_check_failed",
-  "evidence_check_failed",
-  "empty_result",
