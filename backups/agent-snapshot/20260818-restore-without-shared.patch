+): Promise<void> {
+  // 查找绑定该 Note 的 Origin
+  const origins = await tx
+    .select({ id: learningObjectiveOriginsV2.id })
+    .from(learningObjectiveOriginsV2)
+    .where(and(
+      eq(learningObjectiveOriginsV2.workspaceId, workspaceId),
+      eq(learningObjectiveOriginsV2.noteId, noteId),
+    ));
+
+  if (origins.length === 0) return; // 无 Origin 绑定，不需要发事件
+
+  const now = new Date().toISOString();
+  const payload = {
+    schemaAction: "topology.freshness",
+    noteId,
+    reason,
+    originIds: origins.map((o) => o.id),
+    occurredAt: now,
+  };
+
+  await tx.insert(learningOutboxEvents).values({
+    workspaceId,
+    userId: userId ?? "00000000-0000-4000-8000-000000000000", // system user fallback
+    eventType: "topology.freshness",
+    payload: payload as never,
+    projectionHash: `${reason}:${noteId}:${now}`,
+  });
+}
