-    // Supervisor Agent 终态
-    SupervisorRunStatus.SUCCEEDED,
-    SupervisorRunStatus.NEEDS_ATTENTION,
-    SupervisorRunStatus.PARTIAL_READY,
-    SupervisorRunStatus.CANCELLED,
-    SupervisorRunStatus.SUPERSEDED,
-    // v2 终态（兼容）
-    "failed",
-    "terminal_failed",
