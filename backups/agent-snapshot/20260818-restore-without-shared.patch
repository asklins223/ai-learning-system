-  /** 置信水平（0..1，默认 0.95）。 */
-  confidenceLevel: number;
-  /** true 时要求 Wilson 区间下界 ≥ 对应一致性下限才算达标。 */
-  requireCILowerBoundAboveThreshold: boolean;
-}
-
-export interface SilentConsistencyInput {
