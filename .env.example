# 生产环境配置，由 docker-compose.yml 使用。
# 复制为 .env，然后在 `make up` 之前替换所有空的必填值。
# 独立开发栈（`make dev`）使用文档中记录的本地默认值，
# 不需要此文件。

# Postgres -------------------------------------------------------------------
POSTGRES_USER=ailearn
POSTGRES_PASSWORD=
POSTGRES_DB=ailearn

# 数据库角色密码（用于迁移前/后的角色引导脚本）。
# 运行 `make up` 之前必须设置；在真实部署中使用密码管理器，
# 并在三个连接 URL 中对相同值进行 URL 编码。
MIGRATOR_PASSWORD=
API_PASSWORD=
WORKER_PASSWORD=

# 必填的应用连接字符串。将密码中的保留字符进行 URL 编码后再
# 嵌入 URL。
# v0.4：为每个角色使用独立连接字符串（最小权限原则）
DATABASE_URL_MIGRATOR=
DATABASE_URL_API=
DATABASE_URL_WORKER=

# 仅用于本地脚本/测试的旧版回退。生产环境 Compose 不会注入此变量，
# 且当 NODE_ENV=production 时 API/迁移器会拒绝它。
DATABASE_URL=

# 初始生产环境所有者 ----------------------------------------------------
# 仅由显式的 `make seed-owner` 命令使用。生产环境栈
# 不会自动播种账号，seed.ts 在缺少凭据时会报错。
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_WORKSPACE=Personal Workspace

# 应用 ------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# 共享认证限流器。生产环境应保持 `postgres`，这样
# 计数器在 API 重启后仍然存在，且被所有副本共享。
AUTH_RATE_LIMIT_STORE=postgres
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# v0.6：已移除个人 BYOK。AI 平台配置集中在
# config/ai-platforms.json 中。
# 在普通 Linux 生产主机上保持 false。Docker Desktop 可能会在
# 198.18.0.0/15 范围内合成公共 DNS 应答；仅在该已知环境下开启。
AI_ALLOW_DOCKER_DESKTOP_SYNTHETIC_DNS=false
# Fastify proxy-addr 语法。默认仅信任回环/链路本地/私有
# 网络代理；当 API 端口可公开访问时切勿设为 `true`。
TRUST_PROXY=loopback,linklocal,uniquelocal
# 生产环境中 HttpOnly 认证 Cookie 默认为 Secure。对于通过
# 纯 http://localhost 提供的本地类生产环境栈，将其设为 false。
AUTH_COOKIE_SECURE=true
API_BIND_ADDRESS=127.0.0.1
API_PORT=4000
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
# 开发数据库和可选对象存储的主机专用默认值。
# 仅在有意的远程访问且周边网络/防火墙可信时
# 才覆盖绑定地址。
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# AI 平台 ---------------------------------------------------------------
# 所有 AI 平台配置由单个 JSON 配置文件驱动。
# 定义你的平台（使用自定义名称）并将能力映射到它们。
#
# 配置文件位置（默认：config/ai-platforms.json）：
# AI_PLATFORMS_CONFIG=config/ai-platforms.json
#
# config/ai-platforms.json 示例：
# {
#   "platforms": {
#     "myqwen": {
#       "type": "dashscope",
#       "apiKey": "${DASHSCOPE_API_KEY}",
#       "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1"
#     },
#     "free": {
#       "type": "openai_compatible",
#       "apiKey": "${SILICONFLOW_API_KEY}",
#       "baseUrl": "https://api.siliconflow.cn/v1",
#       "options": { "disableThinking": true }
#     },
#     "mock": { "type": "mock" }
#   },
#   "capabilities": {
#     "agent_turn":      { "platform": "myqwen", "model": "qwen-plus" },
#     "text_generation": { "platform": "free",   "model": "glm-4-9b" },
#     "vision":          { "platform": "myqwen", "model": "qwen-vl-plus" },
#     "embedding":       { "platform": "free",   "model": "BAAI/bge-m3" }
#   }
# }
#
# 平台类型（代码层面，决定传输协议）：
#   mock              — 本地启发式生成器（零依赖）
#   dashscope         — 阿里云百炼 / 通义千问
#   openai_compatible — 任何 OpenAI 兼容 API（腾讯 MaaS、vLLM、Ollama 等）
#   siliconflow       — 硅基流动（embedding + rerank）
#
# 添加新平台实例：只需在 JSON 文件的 "platforms" 中添加即可。
# 无需修改代码。
#
# API 密钥通过 JSON 配置中的 ${ENV_VAR} 引用，因此实际的
# 密钥值保留在此 .env 文件中：

# ── API 密钥（通过 ${VAR_NAME} 被 config/ai-platforms.json 引用）──
# DASHSCOPE_API_KEY=
# OPENAI_COMPAT_API_KEY=
# SILICONFLOW_API_KEY=
# BIGMODEL_API_KEY=
# TOKENRHYTHM_API_KEY=

# v0.6：已移除个人 BYOK。AI 平台配置集中在
# config/ai-platforms.json 中。无需加密密钥。

# 嵌套的 provider 调用使用比其 Worker 任务更短的超时预算，
# 以便 v0.6 处理器仍能在租约到期前持久化回退/重试状态。
WORKER_PROVIDER_TIMEOUT_MS=75000

# 旧版回退 — 仅当 config/ai-platforms.json 不存在时作为系统默认 provider 使用。
# 需要完整设置对应 provider 的 env（仅设 AI_PROVIDER_* 名称还不够）：
#   AI_PROVIDER_AGENT_TURN=mock | openai_compatible | dashscope | siliconflow
#   AI_PROVIDER_EMBEDDING=
#   openai_compatible → OPENAI_COMPAT_API_KEY + OPENAI_COMPAT_BASE_URL + OPENAI_COMPAT_MODEL
#   dashscope         → DASHSCOPE_API_KEY（BASE_URL/MODEL 有默认值）
#   siliconflow       → SILICONFLOW_API_KEY（embedding 模型默认 BAAI/bge-m3）

# v0.6 功能开关（计划 §12.2）--------------------------------------------
# AI 生成的验证问题（QUEST-01，计划 §7.1）。服务端
# 能力为可选开启；禁用模式使用确定性安全回退。
AI_QUESTION_V1_ENABLED=false
# 评分标准评估（EVAL-02，计划 §7.2-§7.3）。保持禁用，直到
# 发布门控显式启用 provider 支持的评估。
RUBRIC_EVALUATION_V1_ENABLED=false
# 官方调度策略。v0.6 discrete-v2 在发布期间为可选开启。
SCHEDULER_POLICY_VERSION=discrete-v1
# 卡片质量评估和条件修复（CARD-02，计划 §7.7）
# 启用后，硬触发的质量问题（如捏造引用）会导致
# 对同一 Provider/model 发起单次条件修复调用。
CARD_REPAIR_V1_ENABLED=false
# FSRS 影子调度（SCHED-02，计划 §6.8）
# 启用后，仅追加的影子决策会写入
# scheduling_shadow_decisions，仅用于离线对比。
# 影子写入不会影响官方 discrete-v2 调度。
FSRS_SHADOW_ENABLED=false
# 前端功能开关（NEXT_PUBLIC_ 前缀用于客户端访问）
# 问题优先聚焦 UI（UX-06，计划 §9.1-§9.5）
# 禁用时，验证入口按钮隐藏，用户看到安全回退。
NEXT_PUBLIC_QUESTION_FIRST_UI_ENABLED=false
# AI 问题生成（QUEST-01，计划 §7.1）
NEXT_PUBLIC_AI_QUESTION_V1_ENABLED=false
# 评分标准评估（EVAL-02，计划 §7.2-§7.3）
NEXT_PUBLIC_RUBRIC_EVALUATION_V1_ENABLED=false
# 卡组轮播 UI（docs/plans/card-set-carousel-ui.md §7.1）
NEXT_PUBLIC_CARD_SET_DECK_UI_ENABLED=true
# Agent 活动流控制台（docs/plans/learning-card-generation-agent-stream-ui.md §8，Phase B/C）
# 关闭时（默认）生成进度展示与 Phase A 落地后的现状一致。
NEXT_PUBLIC_AGENT_ACTIVITY_STREAM_ENABLED=false

# 来源 URL 抓取器 ---------------------------------------------------------
# Worker 的 URL 来源抓取器使用的 User-Agent。默认使用 Chrome UA
# 以避免反爬对策（如 Bilibili 验证码页面）。仅在
# 特定站点需要不同 UA 时覆盖。
# SOURCE_FETCH_USER_AGENT=

# URL 抓取的 Accept-Encoding。默认支持 gzip/deflate/br/identity。
# 设为 "identity" 可禁用压缩（在解压导致问题时回滚）。
# 需要重启 Worker 才能生效。
# SOURCE_FETCH_ACCEPT_ENCODING=gzip, deflate, br, identity

# 瞬时 URL 抓取错误的重试次数（ECONNRESET、DNS 失败、
# 超时）。默认 1（共 2 次尝试）。设为 0 可禁用重试。
# 不要超过 1 — 重试延迟为线性，总时间必须保持在
# 60s 的 parse_source 任务超时之内。
# SOURCE_FETCH_RETRY_COUNT=1

# 可选 MinIO / S3 --------------------------------------------------------
# 仅在使用 `make storage` 启动 `storage` profile 时需要。
# 生产环境 MinIO 服务在任一凭据为空时立即退出；
# 它不会回退到镜像的已知默认值。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_BUCKET=ailearn-workspaces
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
