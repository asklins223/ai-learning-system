# Production configuration used by docker-compose.yml.
# Copy to .env, then replace every empty required value before `make up`.
# The standalone development stack (`make dev`) uses documented local-only
# defaults and does not require this file.

# Postgres -------------------------------------------------------------------
POSTGRES_USER=ailearn
POSTGRES_PASSWORD=
POSTGRES_DB=ailearn

# Database role passwords (used by the pre/post-migration role bootstrap).
# These must be set before running `make up`; use a password manager in real
# deployments and URL-encode the same values in the three connection URLs.
MIGRATOR_PASSWORD=
API_PASSWORD=
WORKER_PASSWORD=

# Required application connection strings. URL-encode reserved characters in
# the password before embedding it in the URL.
# v0.4: Separate connection strings for each role (least privilege)
DATABASE_URL_MIGRATOR=
DATABASE_URL_API=
DATABASE_URL_WORKER=

# Legacy fallback for local scripts/tests only. Production Compose does not
# inject this variable and the API/migrator reject it when NODE_ENV=production.
DATABASE_URL=

# Initial production owner ----------------------------------------------------
# Used only by the explicit `make seed-owner` command. The production stack
# never seeds an account automatically and seed.ts rejects missing credentials.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_WORKSPACE=Personal Workspace

# App ------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Shared authentication rate limiter. Production should keep `postgres` so
# counters survive API restarts and are shared by every replica.
AUTH_RATE_LIMIT_STORE=postgres
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# Personal-model connection probe: five attempts per user every five minutes,
# with a hard outbound timeout. Keep the timeout between 1000 and 60000 ms.
AI_MODEL_TEST_RATE_LIMIT_WINDOW_MS=300000
AI_MODEL_TEST_RATE_LIMIT_MAX_ATTEMPTS=5
AI_MODEL_TEST_TIMEOUT_MS=15000
# Keep false on normal Linux production hosts. Docker Desktop may synthesize
# public DNS answers in 198.18.0.0/15; opt in only for that known environment.
AI_ALLOW_DOCKER_DESKTOP_SYNTHETIC_DNS=false
# Fastify proxy-addr syntax. The default trusts only loopback/link-local/private
# network proxies; never set `true` when the API port is publicly reachable.
TRUST_PROXY=loopback,linklocal,uniquelocal
# HttpOnly auth cookie is Secure by default in production. For a local
# production-like stack served over plain http://localhost, set this to false.
AUTH_COOKIE_SECURE=true
API_BIND_ADDRESS=127.0.0.1
API_PORT=4000
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
# Host-only defaults for development database and optional object storage.
# Override the bind address only when remote access is intentional and the
# surrounding network/firewall is trusted.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# AI provider ----------------------------------------------------------------
# mock      — local heuristic generator (default, no external dependency)
# dashscope — Alibaba Cloud Model Studio / Qwen
AI_PROVIDER_CARD=mock
# Required only for personal BYOK settings. Generate 32 random bytes and keep
# this value stable/backed up; changing it makes previously saved keys unreadable.
# Example generator: openssl rand -base64 32
AI_CREDENTIAL_ENCRYPTION_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# qwen3/qwen3.5 hybrid models default to thinking mode, which front-loads a
# long hidden reasoning phase and makes bounded non-streaming JSON calls time
# out on every request. The worker therefore sends enable_thinking=false by
# default; set true only if you deliberately want thinking output.
DASHSCOPE_ENABLE_THINKING=false
# Same switch for qwen3-class models behind an OpenAI-compatible gateway
# (DashScope compatible-mode, vLLM). Opt-in because strict OpenAI endpoints
# reject unknown request fields.
OPENAI_COMPAT_DISABLE_THINKING=false
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Nested provider calls use a shorter budget than their Worker job so v0.6
# handlers can still persist fallback/retry state before the lease expires.
WORKER_PROVIDER_TIMEOUT_MS=75000

# v0.6 feature flags (计划 §12.2) --------------------------------------------
# AI-generated validation questions (QUEST-01, 计划 §7.1). The server-side
# capability is opt-in; disabled mode uses the deterministic safe fallback.
AI_QUESTION_V1_ENABLED=false
# Rubric evaluation (EVAL-02, 计划 §7.2-§7.3). Keep disabled until the rollout
# gate explicitly enables provider-backed evaluation.
RUBRIC_EVALUATION_V1_ENABLED=false
# Official scheduling policy. v0.6 discrete-v2 is opt-in during rollout.
SCHEDULER_POLICY_VERSION=discrete-v1
# Card quality assessment and conditional repair (CARD-02, 计划 §7.7)
# When enabled, hard-trigger quality issues (e.g. fabricated quotes) cause a
# single conditional repair call to the same Provider/model.
CARD_REPAIR_V1_ENABLED=false
# FSRS shadow scheduling (SCHED-02, 计划 §6.8)
# When enabled, append-only shadow decisions are written to
# scheduling_shadow_decisions for offline comparison only.
# Shadow writes do NOT affect the official discrete-v2 schedule.
FSRS_SHADOW_ENABLED=false
# Resumable learning-card generation runs (engine v2). M6 makes this the
# default for new requests. Rollback is an atomic two-flag operation: set this
# AND NEXT_PUBLIC_CARD_GENERATION_V2_ENABLED to false, rebuild Web (the public
# flag is build-time), then restart API and Worker. Do not roll back migration
# 0049; keep the rollback-capable handlers available for in-flight v2 runs.
CARD_GENERATION_V2_ENABLED=true
# Frontend feature flags (NEXT_PUBLIC_ prefix for client-side access)
# Question-first Focus UI (UX-06, 计划 §9.1-§9.5)
# When disabled, validation CTA is hidden and users see a safe fallback.
NEXT_PUBLIC_QUESTION_FIRST_UI_ENABLED=false
# AI question generation (QUEST-01, 计划 §7.1)
NEXT_PUBLIC_AI_QUESTION_V1_ENABLED=false
# Rubric evaluation (EVAL-02, 计划 §7.2-§7.3)
NEXT_PUBLIC_RUBRIC_EVALUATION_V1_ENABLED=false
# Must match CARD_GENERATION_V2_ENABLED. Changing this value requires a Web
# rebuild/redeploy; changing only one flag creates a split-brain UI/API rollout.
NEXT_PUBLIC_CARD_GENERATION_V2_ENABLED=true

# Source URL fetcher ---------------------------------------------------------
# User-Agent for the worker's URL source fetcher. Defaults to a Chrome UA to
# avoid anti-bot countermeasures (e.g. Bilibili CAPTCHA pages). Override only
# if a specific site requires a different UA.
# SOURCE_FETCH_USER_AGENT=

# Accept-Encoding for URL fetch. Default supports gzip/deflate/br/identity.
# Set to "identity" to disable compression (rollback if decompression causes
# issues). Requires Worker restart to take effect.
# SOURCE_FETCH_ACCEPT_ENCODING=gzip, deflate, br, identity

# Number of retries for transient URL fetch errors (ECONNRESET, DNS failures,
# timeouts). Default 1 (2 total attempts). Set to 0 to disable retries.
# Do not exceed 1 — retry delay is linear and total time must stay within the
# 60s parse_source job timeout.
# SOURCE_FETCH_RETRY_COUNT=1

# Optional MinIO / S3 --------------------------------------------------------
# Required only when starting the `storage` profile with `make storage`.
# The production MinIO service exits immediately when either credential is
# empty; it never falls back to the image's well-known defaults.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_BUCKET=ailearn-workspaces
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
