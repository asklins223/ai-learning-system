# 生产环境配置，由 docker-compose.yml 使用。
# 复制为 .env，然后在 `make up` 之前替换所有空的必填值。
# 独立开发栈（`make dev`）使用文档中记录的本地默认值，
# 不需要此文件。

# Postgres -------------------------------------------------------------------
POSTGRES_USER=ailearn
POSTGRES_PASSWORD=
POSTGRES_DB=ailearn

# 数据库角色密码（用于迁移前/后的角色引导脚本）。
# 运行 `make up` 之前必须设置；在真实部署中使用密码管理器，
# 并在三个连接 URL 中对相同值进行 URL 编码。
MIGRATOR_PASSWORD=
API_PASSWORD=
WORKER_PASSWORD=

# 必填的应用连接字符串。将密码中的保留字符进行 URL 编码后再
# 嵌入 URL。
# v0.4：为每个角色使用独立连接字符串（最小权限原则）
DATABASE_URL_MIGRATOR=
DATABASE_URL_API=
DATABASE_URL_WORKER=

# 仅用于本地脚本/测试的旧版回退。生产环境 Compose 不会注入此变量，
# 且当 NODE_ENV=production 时 API/迁移器会拒绝它。
DATABASE_URL=

# 初始生产环境所有者 ----------------------------------------------------
# 仅由显式的 `make seed-owner` 命令使用。生产环境栈
# 不会自动播种账号，seed.ts 在缺少凭据时会报错。
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_WORKSPACE=Personal Workspace

# 应用 ------------------------------------------------------------------------
# 仅浏览器客户端需要；desktop-client 的主进程直连 API，默认留空即可。
CORS_ORIGIN=
LOG_LEVEL=info
# 伴星中心的基础能力在示例、开发与生产编排中保持同一默认值；需要外部模型或
# 设备权限的增强能力仍单独 fail-closed。
# P2 real text dialogue capability.
COMPANION_DIALOGUE_V1_ENABLED=true
# P3 half-duplex ASR/TTS capability; requires P2 and provider credentials.
COMPANION_VOICE_DIALOGUE_V1_ENABLED=false
# P6 streaming voice capability; keep false while streaming remains blocked.
COMPANION_STREAMING_VOICE_V1_ENABLED=false
# P5 typed learning-action proposal/confirmation bridge.
COMPANION_JOURNEY_V2=true
COMPANION_BRIDGE_V2=true
# 22 真桌宠记忆、画像、动态与日汇总基础链路。
COMPANION_MEMORY_VECTOR_V1=true
COMPANION_MEMORY_EXTRACTOR_V1=true
COMPANION_SUMMARIZER_V1=true
COMPANION_PET_PROFILE_V1=true
COMPANION_MEMORY_STAR_MAP_V1=true
COMPANION_PROACTIVE_PERSONALIZED_V1=true
COMPANION_DAILY_SUMMARY_V1=true
# 主动念头：候选打底用确定性规则，不足 3 条时由模型补写（同一份 here_and_now 事实）。
# 不再单独设 "LLM 增强" 开关——关掉它就等于让主动提醒只能念三句模板。
COMPANION_THOUGHTS_V1=true
# 共享认证限流器。生产环境应保持 `postgres`，这样
# 计数器在 API 重启后仍然存在，且被所有副本共享。
AUTH_RATE_LIMIT_STORE=postgres
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# v0.6：已移除个人 BYOK。AI 平台配置集中在
# config/ai-platforms.json 中。
# 在普通 Linux 生产主机上保持 false。Docker Desktop 可能会在
# 198.18.0.0/15 范围内合成公共 DNS 应答；仅在该已知环境下开启。
AI_ALLOW_DOCKER_DESKTOP_SYNTHETIC_DNS=false
# 默认不信任客户端提供的 X-Forwarded-For。只有在前置代理明确覆写
# X-Forwarded-For 后，才按该代理的实际 hop/IP 显式配置 TRUST_PROXY。
TRUST_PROXY=false
# 生产环境中 HttpOnly 认证 Cookie 默认为 Secure。对于通过
# 纯 http://localhost 提供的本地类生产环境栈，将其设为 false。
AUTH_COOKIE_SECURE=true
API_BIND_ADDRESS=127.0.0.1
API_PORT=4000
# Desktop local trust (required before a desktop client can send credentials).
# Generate a random base64url value with at least 32 decoded bytes.
AILEARN_DESKTOP_PAIRING_KEY_ID=
AILEARN_DESKTOP_PAIRING_SECRET=
AILEARN_DOMAIN_SCHEMA_REVISION=
# Desktop main-process development origin/config revision.
DESKTOP_API_ORIGIN=http://127.0.0.1:4000
DESKTOP_DEPLOYMENT_CONFIG_REVISION=desktop-dev-config-v1
# 开发数据库和可选对象存储的主机专用默认值。
# 仅在有意的远程访问且周边网络/防火墙可信时
# 才覆盖绑定地址。
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# AI 平台 ---------------------------------------------------------------
# 所有 AI 平台配置由单个 JSON 配置文件驱动。
# 定义你的平台（使用自定义名称）并将能力映射到它们。
#
# 配置文件位置（默认：config/ai-platforms.json）：
# AI_PLATFORMS_CONFIG=config/ai-platforms.json
#
# config/ai-platforms.json 示例：
# {
#   "platforms": {
#     "myqwen": {
#       "type": "dashscope",
#       "apiKey": "${DASHSCOPE_API_KEY}",
#       "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1"
#     },
#     "free": {
#       "type": "openai_compatible",
#       "apiKey": "${SILICONFLOW_API_KEY}",
#       "baseUrl": "https://api.siliconflow.cn/v1",
#       "options": { "disableThinking": true }
#     },
#     "mock": { "type": "mock" }
#   },
#   "capabilities": {
#     "agent_turn":      { "platform": "myqwen", "model": "qwen-plus" },
#     "text_generation": { "platform": "free",   "model": "glm-4-9b" },
#     "vision":          { "platform": "myqwen", "model": "qwen-vl-plus" },
#     "embedding":       { "platform": "free",   "model": "BAAI/bge-m3" }
#   }
# }
#
# 平台类型（代码层面，决定传输协议）：
#   mock              — 本地启发式生成器（零依赖）
#   dashscope         — 阿里云百炼 / 通义千问
#   openai_compatible — 任何 OpenAI 兼容 API（腾讯 MaaS、vLLM、Ollama 等）
#   siliconflow       — 硅基流动（embedding + rerank）
#   opencode_go       — OpenCode Go（OpenAI Responses API /responses；muse-spark-* 等模型）
#
# opencode_go 换模型时的 options 注意事项（各模型差异实测于 2026-09）：
#   reasoningEffort      — Responses API 的 reasoning 档位（none|minimal|low|medium|high|xhigh|max，
#                            显式值优先于 disableThinking/enableThinking）。不设则用网关默认
#                            （思考开启）。各模型支持范围不同，设错直接 400：
#                            · muse-spark-*   minimal/low/medium/high/xhigh（不支持 none / max）
#                            · deepseek-*     全档可用（UI 显示为 Off/Low/High/Max）
#                            · gpt-5.6-luna   不支持 minimal（支持 none）
#   contextWindowTokens  — 换模型时必须同步改成该模型真实上下文（缺省为 muse-spark 的 1,048,576）
#   maxOutputTokens      — 同上（缺省 131,072）
#
#   思考模式 + 工具循环：deepseek 系要求把上一轮 reasoning 回传，否则工具循环第二步
#   400「The reasoning_text in the thinking mode must be passed back」。agent turn 契约
#   已承载 provider 不透明的 reasoning 句柄（AgentTurnResult.reasoning →
#   messages[].reasoning，明文推理已在 provider 侧剥离）：同一 job 内靠内存透传；
#   「用户确认后续跑」的冷启动路径把句柄持久化在 companion_agent_tool_calls.
#   reasoning_handles（0218 迁移），因此开启思考也能跑通整条链路。
#   唯一例外：0218 之前创建的待确认提案没有句柄，deepseek 在续跑时会非重试 400
#   （muse-spark/grok-4.6 不受影响）——让这些提案过期后重新发起即可。
#
#   另注：/responses 只服务 muse-spark-*、deepseek-*、grok-4.6、gpt-5.6-luna；
#         其余模型（glm/kimi/minimax/qwen/hy/longcat/mimo 等）请另建
#         "type": "openai_compatible" 的平台实例指向同一 baseUrl（走 /chat/completions）。
#
# 添加新平台实例：只需在 JSON 文件的 "platforms" 中添加即可。
# 无需修改代码。
#
# 当前默认：capabilities.agent_turn → tokenrhythm（基元中转）+ qwen3.8-flash
# （1M 上下文 / 131K 输出；enableThinking 开启，上限见该平台 options）。
# opencode-go 平台保留为备用（muse-spark-1.3-contributor），切回只需改
# capabilities.agent_turn 的 platform/model。
#
# API 密钥通过 JSON 配置中的 ${ENV_VAR} 引用，因此实际的
# 密钥值保留在此 .env 文件中：

# ── API 密钥（通过 ${VAR_NAME} 被 config/ai-platforms.json 引用）──
# DASHSCOPE_API_KEY=
# OPENAI_COMPAT_API_KEY=
# SILICONFLOW_API_KEY=
# BIGMODEL_API_KEY=
# TOKENRHYTHM_API_KEY=
# OPENCODE_GO_API_KEY=
# ── LearningRun 独立 Assessment Critic（OpenAI-compatible；仅 api 容器读取）──
# 未配置时 text/voice 评估 fail-closed 为 not_assessable（prod 必须显式设置 URL）。
# KEY 留空则回退 DASHSCOPE_API_KEY；MODEL 留空则用 qwen-plus。
# ASSESSMENT_CRITIC_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# ASSESSMENT_CRITIC_KEY=
# ASSESSMENT_CRITIC_MODEL=qwen-plus
# ── mock 回退严格模式（AI P0-1）──
# true：系统级 provider 未配置时 fail-closed（抛 ai_provider_not_configured），
#       不再回退 mock（mock 会产出固定假文本并可能作为回复/记忆落库）。
# 生产 compose 默认 true；本地/桌面/离线场景可设 false 保留降级。
# AI_REQUIRE_CONFIGURED_PROVIDER=true
# 语音 TTS（Docker 容器内 edge-tts；api 容器内默认 http://edge-tts:8080）
# EDGE_TTS_BASE_URL=
# 容器鉴权共享 token（edge-tts 与 api 必须一致；compose 强制配置，缺失则启动失败）
# EDGE_TTS_AUTH_TOKEN=
# edge-tts 并发上限（AI P2）：edge 路径此前无限制。
# 默认 4；客户端本身按段串行，此值只在多客户端/直连时生效。
# EDGE_TTS_MAX_CONCURRENCY=4
# qwen TTS 全局并发上限（稳定 P0）：同一用户（workspace:user）的段落严格串行，
# 不同用户并行但总量受此值约束——取代此前的全局串行队列（一个用户会阻塞所有人）。
# 默认 4；调大提高多用户吞吐，同时更容易撞上阿里限流（Requests rate limit exceeded）。
# QWEN_TTS_MAX_CONCURRENCY=4
# 拓扑快照 TTL 缓存（perf #4）：命中时 304 路径零 DB 成本。默认 10s；0 关闭。
# 取舍：内容变化到可见之间有 ≤TTL 的延迟（拓扑是阅读视图，可接受）。
# TOPOLOGY_SNAPSHOT_CACHE_MS=10000

# v0.6：已移除个人 BYOK。AI 平台配置集中在
# config/ai-platforms.json 中。无需加密密钥。

# 嵌套的 provider 调用使用比其 Worker 任务更短的超时预算，
# 以便 v0.6 处理器仍能在租约到期前持久化回退/重试状态。
WORKER_PROVIDER_TIMEOUT_MS=75000

# 来源 URL 抓取器 ---------------------------------------------------------
# Worker 的 URL 来源抓取器使用的 User-Agent。默认使用 Chrome UA
# 以避免反爬对策（如 Bilibili 验证码页面）。仅在
# 特定站点需要不同 UA 时覆盖。
# SOURCE_FETCH_USER_AGENT=

# URL 抓取的 Accept-Encoding。默认支持 gzip/deflate/br/identity。
# 设为 "identity" 可禁用压缩（在解压导致问题时回滚）。
# 需要重启 Worker 才能生效。
# SOURCE_FETCH_ACCEPT_ENCODING=gzip, deflate, br, identity

# 瞬时 URL 抓取错误的重试次数（ECONNRESET、DNS 失败、
# 超时）。默认 1（共 2 次尝试）。设为 0 可禁用重试。
# 不要超过 1 — 重试延迟为线性，总时间必须保持在
# 60s 的 parse_source 任务超时之内。
# SOURCE_FETCH_RETRY_COUNT=1

# 可选 MinIO / S3 --------------------------------------------------------
# 仅在使用 `make storage` 启动 `storage` profile 时需要。
# 生产环境 MinIO 服务在任一凭据为空时立即退出；
# 它不会回退到镜像的已知默认值。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# 2026-08-12（最小权限）：应用侧可用仅限目标 bucket 的独立 access key
# （S3Client 优先读 MINIO_ACCESS_KEY/SECRET_KEY，缺省回退 root 凭证）。
# 生产建议创建 bucket 级 policy 的专用 key，避免 root 泄露即完全控制存储。
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
S3_BUCKET=ailearn-workspaces
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# S3 客户端端点与区域（默认 http://minio:9000 / us-east-1；切真实 AWS S3 时必改）
STORAGE_ENDPOINT=
S3_REGION=
# S3 请求超时（毫秒，默认 120000；MinIO 半挂时防止下载请求无限挂起 OOM）
STORAGE_REQUEST_TIMEOUT_MS=

# Companion grounded-tutor grant 签名密钥（fail-closed：未配置则 grant 签发 503）。
# dev 由 docker-compose.dev.yml 显式提供 ailearn-dev-auth-surface-secret；
# staging/生产必须设置为强随机值。
AUTH_SURFACE_MANIFEST_SECRET=

# ─── 统一学习闭环 capability 切换 ───
LEARNING_RUN_ENABLED=false
# 文档 16 §12.7：LearningTask 草稿 AES-256-GCM 静态加密密钥（64 位 hex）。
# 未配置时草稿读写 fail closed（409 draft_encryption_unavailable）。
# dev 用随机值即可；生产必须换成强随机密钥（openssl rand -hex 32）。
LEARNING_DRAFT_ENC_KEY=
# 文档 16 §15.1：投影 checkpoint token HMAC 签名密钥（≥16 字符）。
# 未配置时 checkpoint 不签发（fail closed）→ envelope 永远 pending、星图
# 投影永不推进。dev 用随机值即可；生产必须换成强随机密钥。
PROJECTION_CHECKPOINT_SECRET=

# ─── 方案 20 Card Generation V2（worker 四阶段 LLM 管道）───
# LLM 模式开关：true 走真实四阶段 provider；非 true 走确定性 provider
# （仅离线/测试；生产必须为 true，否则 worker fail-closed 拒绝执行）。
CARD_GENERATION_V2_LLM=
# 单次 provider 调用的中止预算（毫秒，默认 75000）。
V2_PROVIDER_CALL_TIMEOUT_MS=
# 单次 chatJson 的内部退避重试次数（默认 2；0 关闭）。用于吸收瞬时 5xx/429/
# 超时/模型 JSON 不完整，避免一次抖动触发整条已付费管道重放。
V2_PROVIDER_CALL_RETRIES=
# 单 job 执行内的 LLM 调用总数上限（默认 96），超出即 non-retryable 终结。
V2_MAX_LLM_CALLS_PER_JOB=
# 单 job 墙钟预算（毫秒，默认 1200000 = 20min，须小于 30min 租约窗口）：
# 到期中止在途 LLM 调用并终结 job（不重试），run → needs_attention。
V2_PIPELINE_BUDGET_MS=
# 租约续租/丢失探测间隔（毫秒，默认 120000 = 2min；须小于租约窗口）。
V2_LEASE_RENEWAL_INTERVAL_MS=
# 源文本 / 证据文本进入 prompt 的字符上限（默认 60000 / 40000 / 单条 2000），
# 超限截断并告警（防止 O(candidates × evidence) token 与内存峰值）。
V2_SOURCE_CONTENT_MAX_CHARS=
V2_EVIDENCE_TOTAL_MAX_CHARS=
V2_EVIDENCE_QUOTE_MAX_CHARS=
# 模型原始输出片段是否进普通日志（默认关闭；=1 仅用于排查，勿在生产开启）。
V2_LLM_DEBUG_PAYLOADS=
# 生产环境显式豁免"确定性 provider 禁止在生产运行"护栏（仅在确需离线复现时设置）。
V2_ALLOW_DETERMINISTIC_PROVIDERS=
