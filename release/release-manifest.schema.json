{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/asklins223/ai-learning-system/main/release/release-manifest.schema.json",
  "title": "AI Learning System release manifest",
  "description": "Machine-readable post-tag CI/release artifact for one release candidate or final release. The artifact stays untracked; relational and release-gate checks are enforced by release-check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "tag",
    "commit",
    "sourceDateEpoch",
    "nodeVersion",
    "generatedAt",
    "migration",
    "images",
    "tests",
    "aiQuality",
    "approvals"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.[1-9][0-9]*)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "nodeVersion": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "migration": {
      "$ref": "#/$defs/migration"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "web", "worker"],
      "properties": {
        "api": { "$ref": "#/$defs/image" },
        "web": { "$ref": "#/$defs/image" },
        "worker": { "$ref": "#/$defs/image" }
      }
    },
    "tests": {
      "$ref": "#/$defs/tests"
    },
    "aiQuality": {
      "$ref": "#/$defs/aiQuality"
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "securityDataReviewer"],
      "properties": {
        "owner": { "$ref": "#/$defs/approval" },
        "securityDataReviewer": { "$ref": "#/$defs/approval" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journalPath", "journalDigest", "latestMigration", "migrationCount"],
      "properties": {
        "journalPath": {
          "const": "apps/api/src/db/migrations/meta/_journal.json"
        },
        "journalDigest": {
          "$ref": "#/$defs/sha256"
        },
        "latestMigration": {
          "type": "string",
          "pattern": "^[0-9]{4}_[a-z0-9_]+$"
        },
        "migrationCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "provenance"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "platform": {
          "type": "string",
          "pattern": "^[a-z0-9_]+/[a-z0-9_.-]+$"
        },
        "provenance": { "$ref": "#/$defs/imageProvenance" }
      }
    },
    "imageProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildRunId",
        "builtAt",
        "deploymentEnvironment",
        "observedAt",
        "observedDigest",
        "evidence"
      ],
      "properties": {
        "buildRunId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "builtAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "deploymentEnvironment": { "type": "string", "minLength": 1 },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "observedDigest": { "$ref": "#/$defs/sha256" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": ["passed", "failed", "not_run", "not_applicable"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "testSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "skipped", "todo"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "todo": { "type": "integer", "minimum": 0 }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "unit",
        "integration",
        "e2e",
        "coverage",
        "dependencyScan",
        "secretScan",
        "containerScan"
      ],
      "properties": {
        "summary": { "$ref": "#/$defs/testSummary" },
        "unit": { "$ref": "#/$defs/gate" },
        "integration": { "$ref": "#/$defs/gate" },
        "e2e": { "$ref": "#/$defs/gate" },
        "coverage": { "$ref": "#/$defs/gate" },
        "dependencyScan": { "$ref": "#/$defs/gate" },
        "secretScan": { "$ref": "#/$defs/gate" },
        "containerScan": { "$ref": "#/$defs/gate" }
      }
    },
    "nullableVersion": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "nullableMetric": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "aiProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpointOrigin", "modelId", "modelRevision", "temperature"],
      "properties": {
        "endpointOrigin": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "modelId": { "$ref": "#/$defs/nullableVersion" },
        "modelRevision": { "$ref": "#/$defs/nullableVersion" },
        "temperature": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "aiMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardCitationPrecision", "keyPointHardCoverage", "expectedBlockHardCoverage"],
      "properties": {
        "hardCitationPrecision": { "$ref": "#/$defs/nullableMetric" },
        "keyPointHardCoverage": { "$ref": "#/$defs/nullableMetric" },
        "expectedBlockHardCoverage": { "$ref": "#/$defs/nullableMetric" }
      }
    },
    "aiRunMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardCitationPrecision", "keyPointHardCoverage", "expectedBlockHardCoverage"],
      "properties": {
        "hardCitationPrecision": { "type": "number", "minimum": 0.9, "maximum": 1 },
        "keyPointHardCoverage": { "type": "number", "minimum": 0.85, "maximum": 1 },
        "expectedBlockHardCoverage": { "type": "number", "minimum": 0.85, "maximum": 1 }
      }
    },
    "aiRunResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "completedAt", "metrics", "evidence"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "completedAt": { "type": "string", "format": "date-time" },
        "metrics": { "$ref": "#/$defs/aiRunMetrics" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "aiQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "datasetVersion",
        "datasetDigest",
        "sampleCount",
        "labelVersion",
        "scorerCommit",
        "promptVersion",
        "provider",
        "runs",
        "runResults",
        "metrics",
        "costUsd",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": ["passed", "failed", "not_run", "not_applicable"]
        },
        "datasetVersion": { "$ref": "#/$defs/nullableVersion" },
        "datasetDigest": { "$ref": "#/$defs/sha256" },
        "sampleCount": {
          "type": "integer",
          "minimum": 30
        },
        "labelVersion": { "$ref": "#/$defs/nullableVersion" },
        "scorerCommit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "promptVersion": { "$ref": "#/$defs/nullableVersion" },
        "provider": { "$ref": "#/$defs/aiProvider" },
        "runs": {
          "type": "integer",
          "minimum": 2
        },
        "runResults": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/aiRunResult" }
        },
        "metrics": { "$ref": "#/$defs/aiMetrics" },
        "costUsd": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "passed" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "datasetVersion": { "type": "string", "minLength": 1 },
              "labelVersion": { "type": "string", "minLength": 1 },
              "scorerCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "promptVersion": { "type": "string", "minLength": 1 },
              "provider": {
                "properties": {
                  "endpointOrigin": { "type": "string", "format": "uri" },
                  "modelId": { "type": "string", "minLength": 1 },
                  "modelRevision": { "type": "string", "minLength": 1 },
                  "temperature": { "const": 0.2 }
                }
              },
              "runs": { "type": "integer", "minimum": 2 },
              "metrics": {
                "properties": {
                  "hardCitationPrecision": { "type": "number", "minimum": 0.9, "maximum": 1 },
                  "keyPointHardCoverage": { "type": "number", "minimum": 0.85, "maximum": 1 },
                  "expectedBlockHardCoverage": { "type": "number", "minimum": 0.85, "maximum": 1 }
                }
              },
              "evidence": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "approver", "decidedAt", "evidence"],
      "properties": {
        "decision": {
          "enum": ["approved", "rejected", "pending"]
        },
        "approver": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "decidedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "evidence": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decision": { "const": "approved" } },
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "approver": { "type": "string", "minLength": 1 },
              "decidedAt": { "type": "string", "format": "date-time" },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
