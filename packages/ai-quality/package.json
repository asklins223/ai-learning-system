{
  "name": "@ailearn/ai-quality",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find src -name '*.test.ts' | sort)",
    "pr-gate": "node --import tsx src/cli/pr-gate.ts",
    "rc-gate": "node --import tsx src/cli/rc-gate.ts",
    "rc-smoke": "node --import tsx src/cli/rc-smoke.ts",
    "rc-dry-run": "node --import tsx src/cli/rc-dry-run.ts"
  },
  "dependencies": {
    "@ailearn/shared": "file:../shared",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
